rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function house(code) { return get(/databases/$(database)/documents/houses/$(code)).data; }
    function isMember(code) { return signedIn() && request.auth.uid in house(code).memberIds; }
    function isAdmin(code) { return signedIn() && request.auth.uid == house(code).adminId; }

    /* The code/name entry is governed by ITS OWN adminId, not by the house
       document. Using isAdmin(code) here meant that once a house was deleted
       nobody could ever clear its name entry again, because the check read a
       document that no longer existed. */
    match /houseCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if signedIn() && resource.data.adminId == request.auth.uid;
      allow delete: if signedIn()
        && (resource.data.adminId == request.auth.uid
            || !exists(/databases/$(database)/documents/houses/$(code)));
    }

    match /houses/{code} {
      /* Read is checked against the document itself rather than via a get() —
         cheaper, and unambiguous for collection queries, which is how the app
         finds every house you belong to. */
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.memberIds.size() == 1
        && request.auth.uid in request.resource.data.memberIds;
      // members may edit house data; only the admin may change WHO is a member,
      // except that anyone may remove themselves (i.e. leave the house)
      allow update: if isMember(code)
        && request.resource.data.adminId == resource.data.adminId
        && (request.resource.data.memberIds == resource.data.memberIds
            || request.auth.uid == resource.data.adminId
            || request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid]));
      /* The creator may delete it, and so may anyone clearing out a household
         with no members left — an empty house belongs to nobody, and without
         this an abandoned one would keep its name reserved forever. */
      allow delete: if isAdmin(code) || resource.data.memberIds.size() == 0;

      match /joinRequests/{uid} {
        allow create: if signedIn() && uid == request.auth.uid;
        allow read, delete: if signedIn() && (uid == request.auth.uid || isAdmin(code));
      }

      match /pantry/{item} { allow read, write: if isMember(code); }
      match /trips/{trip} { allow read, write: if isMember(code); }
      match /payments/{pay} { allow read, write: if isMember(code); }
      /* The house's barcode book — products the public databases don't carry,
         named by a member. Same trust boundary as the pantry it feeds. */
      match /barcodes/{bc} { allow read, write: if isMember(code); }
    }
  }
}
