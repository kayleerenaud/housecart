rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function house(code) { return get(/databases/$(database)/documents/houses/$(code)).data; }
    function isMember(code) { return signedIn() && request.auth.uid in house(code).memberIds; }
    function isAdmin(code) { return signedIn() && request.auth.uid == house(code).adminId; }

    match /houseCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if isAdmin(code);
    }

    match /houses/{code} {
      allow read: if isMember(code);
      allow create: if signedIn()
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.memberIds.size() == 1
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isMember(code)
        && request.resource.data.adminId == resource.data.adminId
        && (request.resource.data.memberIds == resource.data.memberIds
            || request.auth.uid == resource.data.adminId);
      allow delete: if isAdmin(code);

      match /joinRequests/{uid} {
        allow create: if signedIn() && uid == request.auth.uid;
        allow read, delete: if signedIn() && (uid == request.auth.uid || isAdmin(code));
      }

      match /pantry/{item} { allow read, write: if isMember(code); }
      match /trips/{trip} { allow read, write: if isMember(code); }
      match /payments/{pay} { allow read, write: if isMember(code); }
    }
  }
}
